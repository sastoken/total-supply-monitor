{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sal-supply-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cmc.sastoken.io",
      "custom_domain": true,
    },
  ],
  "secrets": {
    "required": ["BSC_RPC_URL_PRIMARY", "BSC_RPC_URL_SECONDARY"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "TOKEN_ADDRESS": "0x65b98b81f2525efd6c3f49c44de56db7ea662551",
    "TOKEN_NAME": "SAL",
    "TOKEN_SYMBOL": "SAL",
    "CHAIN_ID": "56",
    "CACHE_TTL": "60",
    "RPC_TIMEOUT_MS": "5000",
  },
}
